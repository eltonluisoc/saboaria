# Fase 1/2 — string de conexao do Neon (Postgres)
DATABASE_URL="postgresql://usuario:senha@host/dbname?sslmode=require"

# Fase 2 — autenticacao admin (JWT)
JWT_SECRET="troque-por-um-segredo-forte"

# Fase 2 — porta do servidor Express
PORT=3333

# Fase 5 — em desenvolvimento, qualquer origem http://localhost:<porta> ja e aceita
# automaticamente pelo CORS. So preencha isso em producao, com a URL real do frontend.
FRONTEND_URL=""

# Fase 7 — Mercado Pago (use credenciais de TESTE, nunca de producao aqui)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Segredo do webhook (painel do Mercado Pago > Sua integracao > Webhooks) -
# diferente do Access Token, usado so pra validar a assinatura x-signature
MERCADOPAGO_WEBHOOK_SECRET=""

# Fase 7 — URL publica do backend, usada pra montar o notification_url do
# webhook do Mercado Pago. Em desenvolvimento local o Mercado Pago nao
# consegue chegar em localhost; preencha com uma URL publica (ex: ngrok)
# soh se for testar o webhook de verdade.
BACKEND_URL=""
