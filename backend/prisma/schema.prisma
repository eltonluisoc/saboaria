generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUsuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senhaHash String   @map("senha_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_usuarios")
}

model Insumo {
  id                 Int      @id @default(autoincrement())
  nome               String
  unidadeMedida      String   @map("unidade_medida")
  custoUnitarioAtual Decimal  @default(0) @map("custo_unitario_atual") @db.Decimal(12, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  compras       CompraInsumo[]
  produtoInsumo ProdutoInsumo[]

  @@map("insumos")
}

model CompraInsumo {
  id            Int      @id @default(autoincrement())
  insumoId      Int      @map("insumo_id")
  quantidade    Decimal  @db.Decimal(12, 4)
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(12, 4)
  dataCompra    DateTime @map("data_compra")
  createdAt     DateTime @default(now()) @map("created_at")

  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@map("compras_insumo")
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  imagemUrl  String?  @map("imagem_url")
  precoVenda Decimal  @map("preco_venda") @db.Decimal(12, 2)
  custoMedio Decimal  @default(0) @map("custo_medio") @db.Decimal(12, 4)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  receita     ProdutoInsumo[]
  itensPedido ItemPedido[]

  @@map("produtos")
}

model ProdutoInsumo {
  id              Int     @id @default(autoincrement())
  produtoId       Int     @map("produto_id")
  insumoId        Int     @map("insumo_id")
  quantidadeUsada Decimal @map("quantidade_usada") @db.Decimal(12, 4)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo  Insumo  @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@map("produto_insumo")
}

model DespesaGeral {
  id          Int      @id @default(autoincrement())
  descricao   String
  valor       Decimal  @db.Decimal(12, 2)
  categoria   String?
  recorrente  Boolean  @default(false)
  dataDespesa DateTime @map("data_despesa")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("despesas_gerais")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String?
  endereco  String?
  cidade    String?
  estado    String?
  cep       String?
  createdAt DateTime @default(now()) @map("created_at")

  pedidos Pedido[]

  @@map("clientes")
}

model Pedido {
  id             Int      @id @default(autoincrement())
  clienteId      Int?     @map("cliente_id")
  origem         String   @default("manual")
  status         String   @default("pendente")
  valorTotal     Decimal  @map("valor_total") @db.Decimal(12, 2)
  formaPagamento String?  @map("forma_pagamento")
  dataPedido     DateTime @default(now()) @map("data_pedido")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cliente Cliente?     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  itens   ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  produtoId     Int     @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@map("itens_pedido")
}
